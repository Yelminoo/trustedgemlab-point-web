
# trusted-gemlab-mobile-backend's URL — same standalone backend the mobile
# app uses. Must be reachable from the browser — the backend's CORS
# allowlist (see its own src/security.ts) needs this exact origin listed.
PUBLIC_API_URL="https://point-backend.trustedgemlab.com"

# Same VAPID key PAIR the backend was configured with (VAPID_PUBLIC_KEY in
# trusted-gemlab-mobile-backend's .env) — only the public half belongs here.
# Must match exactly, or the browser's subscribe() calls silently produce
# subscriptions the backend can't actually send to.
PUBLIC_VAPID_KEY="..."

# Cloudflare Turnstile site key (public half — the secret half goes in
# trusted-gemlab-mobile-backend's TURNSTILE_SECRET_KEY instead). Get both
# from the Cloudflare dashboard: Turnstile -> Add site, using
# point.trustedgemlab.com as the domain. If unset, the widget just doesn't
# render and registration proceeds without it (see Turnstile.tsx).
PUBLIC_TURNSTILE_SITE_KEY="..."
