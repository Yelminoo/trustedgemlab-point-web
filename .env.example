
# trusted-gemlab-mobile-backend's URL — same standalone backend the mobile
# app uses. Must be reachable from the browser (CORS is already open, see
# `app.register(cors, { origin: true })` in that backend's src/index.ts).
PUBLIC_API_URL="https://point-backend.trustedgemlab.com"

# Same VAPID key PAIR the backend was configured with (VAPID_PUBLIC_KEY in
# trusted-gemlab-mobile-backend's .env) — only the public half belongs here.
# Must match exactly, or the browser's subscribe() calls silently produce
# subscriptions the backend can't actually send to.
PUBLIC_VAPID_KEY="..."
