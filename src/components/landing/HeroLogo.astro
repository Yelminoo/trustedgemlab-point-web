---
// The real brand mark (public/logo.svg, copied from mobile-point's
// KLLogo.svg — the same asset the app's member card uses), set inside a
// faceted ring frame built from the app's own brand color. The ring gives
// the hero graphic scale and a gemological "cut stone" feel without
// inventing a competing visual identity — the actual logo stays the
// centerpiece. The diagonal "sweep" is a light gradient clipped to the
// outer facet outline, animated via .animate-gem-sweep (global.css) —
// light catching a facet.
---

<svg viewBox="0 0 320 320" class="h-auto w-64 sm:w-80" role="img" aria-label="Trusted Gemological Laboratory">
  <defs>
    <clipPath id="gem-outline">
      <polygon points="160,20 240,60 300,140 260,260 160,300 60,260 20,140 80,60" />
    </clipPath>
  </defs>

  <!-- outer facet ring -->
  <g fill="none" stroke="var(--color-primary)" stroke-width="1.5" opacity="0.5">
    <polygon points="160,20 240,60 300,140 260,260 160,300 60,260 20,140 80,60" />
    <polygon points="160,80 220,105 245,160 220,225 160,250 100,225 75,160 100,105" />
  </g>

  <g stroke="var(--color-primary)" stroke-width="1" opacity="0.3">
    <line x1="160" y1="20" x2="160" y2="80" />
    <line x1="240" y1="60" x2="220" y2="105" />
    <line x1="300" y1="140" x2="245" y2="160" />
    <line x1="260" y1="260" x2="220" y2="225" />
    <line x1="160" y1="300" x2="160" y2="250" />
    <line x1="60" y1="260" x2="100" y2="225" />
    <line x1="20" y1="140" x2="75" y2="160" />
    <line x1="80" y1="60" x2="100" y2="105" />
  </g>

  <!-- soft medallion plate behind the mark -->
  <circle cx="160" cy="160" r="82" fill="var(--color-primary)" opacity="0.07" />

  <!-- the real logo, centered -->
  <image href="/logo.svg" x="82" y="82" width="156" height="156" />

  <g clip-path="url(#gem-outline)">
    <rect x="-80" y="0" width="120" height="320" fill="white" opacity="0.3" class="animate-gem-sweep" />
  </g>
</svg>
