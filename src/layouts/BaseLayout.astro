---
import { ClientRouter } from 'astro:transitions';

import '@/styles/global.css';
import { AuthHydrator } from '@/components/shared/AuthHydrator';
import { Nav } from '@/components/shared/Nav';

interface Props {
  title: string;
  description?: string;
  // The landing page controls its own full-width section backdrops (each
  // with its own inner max-w container) rather than being clamped to the
  // app's standard content width — every other page keeps the default.
  fullBleed?: boolean;
}

const {
  title,
  description = 'Trusted Gemological Laboratory — gem reports, points, and rewards.',
  fullBleed = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--
      Blocking + is:inline so this runs before first paint, applying any
      explicit saved theme choice before the browser renders anything — the
      alternative (setting it from a React effect after hydration) would
      flash the OS-default theme first whenever it differs from the user's
      saved choice. `<html>` itself is never replaced by ClientRouter page
      transitions, so this only needs to run once per hard load, not per
      transition — see ThemeToggle.tsx for the reactive/toggle half of this.
    -->
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('tgl-theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.setAttribute('data-theme', saved);
          }
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@500&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&display=swap"
    />
    <meta name="description" content={description} />
    <title>{title} · Trusted Gemlab</title>

    <!-- ===== PWA ===== -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#8d1b20" />
    <!-- iOS Safari ignores the manifest for "standalone" launch behavior and
         the home-screen icon — these three tags are the ones it actually
         reads (still required as of current iOS Safari; unlike Chrome/
         Android, Apple hasn't unified this onto the manifest). -->
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Trusted Gemlab" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <ClientRouter />
  </head>
  <body class="min-h-screen bg-bg text-text">
    <!--
      transition:persist keeps these two islands' actual DOM nodes (and their
      live React state) across a same-origin navigation instead of Astro
      tearing them down and remounting fresh copies from the new page — that
      remount-on-every-link-click was the "nav bar reloading" bug. An
      explicit transition:name pins the match instead of relying on Astro's
      default (same tag + position) matching, which is the documented
      best-practice when the persisted element has no other stable id.
    -->
    <AuthHydrator client:load transition:persist transition:name="auth-hydrator" />
    <Nav client:load transition:persist transition:name="site-nav" />
    <main class={fullBleed ? '' : 'mx-auto max-w-5xl px-4 py-8 sm:px-6'}>
      <slot />
    </main>
    <footer class="mx-auto max-w-5xl px-4 py-10 text-center text-xs text-text-secondary sm:px-6">
      Trusted Gemological Laboratory
    </footer>

    <!-- Registered after `load` so it never competes with the page's own
         initial fetches for bandwidth/priority — installability and the
         offline fallback aren't time-critical the way first paint is. -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker.register('/sw.js').catch(function () {});
        });
      }
    </script>
  </body>
</html>
